generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  organizer
  attendee
}

enum EventStatus {
  draft
  published
  canceled
  completed
}

enum RegistrationStatus {
  active
  canceled
}

model User {
  id                    String         @id @default(uuid())
  name                  String
  email                 String         @unique
  passwordHash          String         @map("password_hash")
  role                  Role           @default(attendee)
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  refreshTokens         RefreshToken[]
  events                Event[]
  registrations         Registration[] @relation("UserRegistrations")
  canceledRegistrations Registration[] @relation("CanceledByUser")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Event {
  id            String         @id @default(uuid())
  organizerId   String         @map("organizer_id")
  title         String
  description   String
  startAt       DateTime       @map("start_at")
  timezone      String
  location      String
  capacity      Int
  status        EventStatus    @default(draft)
  deletedAt     DateTime?      @map("deleted_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  organizer     User           @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@index([organizerId])
  @@index([status, startAt])
  @@map("events")
}

model Registration {
  id           String             @id @default(uuid())
  eventId      String             @map("event_id")
  userId       String             @map("user_id")
  status       RegistrationStatus @default(active)
  registeredAt DateTime           @default(now()) @map("registered_at")
  canceledAt   DateTime?          @map("canceled_at")
  canceledBy   String?            @map("canceled_by")

  event          Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User             @relation("UserRegistrations", fields: [userId], references: [id], onDelete: Cascade)
  canceledByUser User?            @relation("CanceledByUser", fields: [canceledBy], references: [id], onDelete: SetNull)

  @@index([eventId, status])
  @@index([userId, status])
  @@map("registrations")
}