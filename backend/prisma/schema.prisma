generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  organizer
  attendee
}

enum EventStatus {
  draft
  published
  canceled
}

enum RegistrationStatus {
  active
  canceled
}

model User {
  id                    String         @id @default(uuid())
  name                  String
  email                 String         @unique
  passwordHash          String
  role                  Role           @default(attendee)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  refreshTokens         RefreshToken[]
  events                Event[]
  registrations         Registration[] @relation("UserRegistrations")
  canceledRegistrations Registration[] @relation("CanceledByUser")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Event {
  id            String         @id @default(uuid())
  organizerId   String
  title         String
  description   String
  startAt       DateTime
  timezone      String
  location      String
  capacity      Int
  status        EventStatus    @default(draft)
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  organizer     User           @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@index([organizerId])
}

model Registration {
  id           String             @id @default(uuid())
  eventId      String             @map("event_id")
  userId       String             @map("user_id")
  status       RegistrationStatus @default(active)
  registeredAt DateTime           @default(now()) @map("registered_at")
  canceledAt   DateTime?          @map("canceled_at")
  canceledBy   String?            @map("canceled_by")

  event          Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User             @relation("UserRegistrations", fields: [userId], references: [id], onDelete: Cascade)
  canceledByUser User?            @relation("CanceledByUser", fields: [canceledBy], references: [id], onDelete: SetNull)

  @@index([eventId, status])
  @@index([userId, status])
  @@map("registrations")
}
