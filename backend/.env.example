NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://postgres:password@localhost:5432/evently?schema=public"
JWT_ACCESS_SECRET=replace_with_a_secure_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_secure_random_refresh_secret
